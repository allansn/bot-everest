import requests

CLAN_TAG = "#2JRP8G0U0"
API_URL = "https://cocproxy.royaleapi.dev/v1"

def buscar_membros():
    url = f"{API_URL}/clans/{CLAN_TAG.replace('#', '%23')}/members"
    resposta = requests.get(url, timeout=20)

    if resposta.status_code == 200:
        dados = resposta.json()
        membros = dados.get("items", [])

        print(f"EVEREST™ - Total de membros: {len(membros)}")

        for membro in membros:
            print(
                membro["name"],
                membro["tag"],
                membro["role"],
                membro.get("trophies", 0)
            )
    else:
        print("Erro ao consultar o clã:", resposta.status_code)

if __name__ == "__main__":
    buscar_membros()